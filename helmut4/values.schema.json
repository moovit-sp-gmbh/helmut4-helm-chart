{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://moovit-sp-gmbh.github.io/helmut4-helm-chart/values.schema.json",
  "title": "Helmut4 chart values",
  "description": "Validation schema for the Helmut4 Helm chart. Parent-chart values are strictly typed; subchart blocks (mongodb, rabbitmq) are intentionally permissive because their subcharts ship their own schemas.",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "namespace",
    "global",
    "appIngress",
    "docker",
    "services"
  ],
  "definitions": {
    "imagePullPolicy": {
      "type": "string",
      "enum": ["Always", "IfNotPresent", "Never"]
    },
    "port": {
      "type": "integer",
      "minimum": 1,
      "maximum": 65535
    },
    "resourceQuantity": {
      "type": ["string", "integer", "number"]
    },
    "resources": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "requests": {
          "type": "object",
          "additionalProperties": { "$ref": "#/definitions/resourceQuantity" }
        },
        "limits": {
          "type": "object",
          "additionalProperties": { "$ref": "#/definitions/resourceQuantity" }
        }
      }
    },
    "service": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "image", "tag", "port"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "image": { "type": "string", "minLength": 1 },
        "tag": { "type": ["string", "number"], "minLength": 1 },
        "port": { "$ref": "#/definitions/port" },
        "replicas": { "type": "integer", "minimum": 0 },
        "resources": { "$ref": "#/definitions/resources" },
        "volumeMounts": { "type": "boolean" },
        "runAsRoot": { "type": "boolean" }
      }
    }
  },
  "properties": {
    "versions": {
      "type": "object",
      "description": "Centralised image tags. Anchored from the rest of the file.",
      "additionalProperties": { "type": ["string", "number"] }
    },
    "credentials": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "storage": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "smb": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "username": { "type": "string" },
                "password": { "type": "string" },
                "domain": { "type": "string" }
              }
            },
            "nfs": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "username": { "type": "string" },
                "password": { "type": "string" }
              }
            }
          }
        }
      }
    },
    "global": {
      "type": "object",
      "additionalProperties": true,
      "required": ["registry", "imagePullPolicy"],
      "properties": {
        "environment": { "type": "string", "minLength": 1 },
        "registry": { "type": "string", "minLength": 1 },
        "imagePullPolicy": { "$ref": "#/definitions/imagePullPolicy" },
        "imagePullSecrets": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["name"],
            "properties": { "name": { "type": "string", "minLength": 1 } }
          }
        },
        "podSecurityContext": {
          "type": "object",
          "description": "Pod-level securityContext applied to every Deployment. Empty object keeps cluster defaults.",
          "additionalProperties": true
        },
        "containerSecurityContext": {
          "type": "object",
          "description": "Container-level securityContext applied to every container. Empty object keeps cluster defaults.",
          "additionalProperties": true
        },
        "storage": {
          "type": "object",
          "description": "Cluster-wide CSI/StorageClass settings. Each entry in `volumes` gets its own StorageClass and PVC.",
          "properties": {
            "csiDriver": { "type": "string" },
            "storageClassName": { "type": "string" },
            "volumes": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["name", "mountPath", "size"],
                "properties": {
                  "name":      { "type": "string", "minLength": 1 },
                  "mountPath": { "type": "string", "minLength": 1 },
                  "size":      { "type": "string", "minLength": 1 },
                  "source":    { "type": "string" },
                  "appMount":  { "type": "boolean", "description": "Mount this volume on all services with volumeMounts: true. Set to false for backup-only volumes." }
                }
              }
            }
          }
        }
      }
    },
    "namespace": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?$",
      "description": "Kubernetes namespace name (DNS-1123 label)."
    },
    "rbac": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "create": { "type": "boolean" },
        "createNamespace": { "type": "boolean" }
      }
    },
    "serviceAccount": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "create": { "type": "boolean" },
        "name": { "type": "string", "minLength": 1 }
      }
    },
    "appIngress": {
      "type": "object",
      "additionalProperties": false,
      "required": ["enabled", "domain"],
      "properties": {
        "enabled": { "type": "boolean" },
        "api": {
          "type": "string",
          "enum": ["ingress", "gateway"],
          "description": "Routing API. `ingress` renders a networking.k8s.io/v1 Ingress (default); `gateway` renders a gateway.networking.k8s.io/v1 HTTPRoute."
        },
        "className": { "type": "string", "minLength": 1 },
        "domain": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[a-zA-Z0-9]([-a-zA-Z0-9]*[a-zA-Z0-9])?(\\.[a-zA-Z0-9]([-a-zA-Z0-9]*[a-zA-Z0-9])?)*$"
        },
        "tls": {
          "type": "object",
          "additionalProperties": false,
          "required": ["enabled", "provider"],
          "properties": {
            "enabled": { "type": "boolean" },
            "secretName": { "type": "string", "minLength": 1 },
            "certIssuer": { "type": "string" },
            "provider": { "type": "string", "enum": ["letsencrypt", "custom"] },
            "certFile": { "type": "string" },
            "keyFile": { "type": "string" }
          }
        },
        "annotations": {
          "type": "object",
          "additionalProperties": { "type": ["string", "number", "boolean"] }
        },
        "gateway": {
          "type": "object",
          "additionalProperties": false,
          "description": "Gateway API settings. Used only when `api` is `gateway`.",
          "properties": {
            "parentRef": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "name": { "type": "string" },
                "namespace": { "type": "string" },
                "sectionName": { "type": "string" }
              }
            },
            "annotations": {
              "type": "object",
              "additionalProperties": { "type": ["string", "number", "boolean"] }
            }
          }
        }
      }
    },
    "docker": {
      "type": "object",
      "additionalProperties": false,
      "required": ["registry", "username", "password"],
      "properties": {
        "registry": { "type": "string", "minLength": 1 },
        "username": { "type": "string" },
        "password": { "type": "string" },
        "email": { "type": "string" }
      }
    },
    "mongodb": {
      "type": "object",
      "description": "Forwarded to the cloudpirates/mongodb subchart; that subchart ships its own schema, so we only mark the block as an object here.",
      "additionalProperties": true
    },
    "rabbitmq": {
      "type": "object",
      "description": "Forwarded to the cloudpirates/rabbitmq subchart; that subchart ships its own schema. The parent chart only adds `webstomp` (consumed by the application Ingress).",
      "additionalProperties": true,
      "properties": {
        "webstomp": { "$ref": "#/definitions/port" }
      }
    },
    "serviceReplicas": { "type": "integer", "minimum": 0 },
    "podDisruptionBudget": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": { "type": "boolean" },
        "minAvailable": { "type": ["integer", "string"] }
      }
    },
    "autoscaling": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": { "type": "boolean" },
        "minReplicas": { "type": "integer", "minimum": 1 },
        "maxReplicas": { "type": "integer", "minimum": 1 },
        "targetCPUUtilizationPercentage": { "type": "integer", "minimum": 1, "maximum": 100 },
        "targetMemoryUtilizationPercentage": { "type": ["integer", "null"], "minimum": 1, "maximum": 100 }
      }
    },
    "serviceMonitor": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": { "type": "boolean" },
        "interval": { "type": "string" },
        "scrapeTimeout": { "type": "string" },
        "path": { "type": "string" },
        "labels": {
          "type": "object",
          "additionalProperties": { "type": "string" }
        }
      }
    },
    "services": {
      "type": "object",
      "description": "Per-microservice deployment settings. Every value follows the `service` shape.",
      "additionalProperties": { "$ref": "#/definitions/service" }
    },
    "mongobackup": {
      "type": "object",
      "additionalProperties": false,
      "description": "Scheduled MongoDB backup Deployment (moovit mcc_mongodb_backup container).",
      "properties": {
        "enabled": { "type": "boolean" },
        "image": { "type": "string", "minLength": 1 },
        "tag": { "type": ["string", "number"], "minLength": 1 },
        "mongoHost": { "type": "string" },
        "schedule": { "type": "string", "minLength": 1 },
        "maxBackups": { "type": ["integer", "string"], "minimum": 1 },
        "initBackup": { "type": "boolean" },
        "backupClaim": { "type": "string", "minLength": 1 },
        "podSecurityContext": { "type": "object", "additionalProperties": true },
        "containerSecurityContext": { "type": "object", "additionalProperties": true },
        "resources": { "$ref": "#/definitions/resources" }
      }
    },
    "topologySpread": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": { "type": "boolean" }
      }
    },
    "networkPolicy": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": { "type": "boolean" },
        "ingressControllerNamespace": { "type": "string", "minLength": 1 }
      }
    }
  }
}
